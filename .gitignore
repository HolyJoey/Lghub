# Whitelist: only what the app needs to build, run and be understood. Everything else stays
# local: Logitech/DTS files, the Wine prefix, extracted depots, analysis output, test audio,
# and development tools (scanner config, reverse-engineering scripts, test harnesses).
/*
!/.gitignore
!/.github/
!/README.md
!/LICENSE
!/TODO.md
!/*.py
!/install.sh
!/uninstall.sh
!/lghub-bluevoice.svg
!/tests/
!/bridge/
bridge/*
!bridge/bluevoice_bridge.c
!bridge/surround_bridge.c
!bridge/micopt.c
!bridge/micopt.h
!bridge/hx2e.c
!bridge/hx2e.h
!bridge/bv2.c
!bridge/bv2.h
!bridge/peloader.c
!bridge/peloader.h
!/docs/
docs/*
!docs/apo-parameters.md
!docs/protocol.md
!docs/screenshots/
__pycache__/
